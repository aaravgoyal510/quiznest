datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         Role          @default(STUDENT)
  department   String?
  year         String?
  avatarUrl    String?
  tokenVersion Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  createdSubjects  Subject[]       @relation("SubjectCreator")
  createdQuestions Question[]      @relation("QuestionCreator")
  createdQuizzes   Quiz[]          @relation("QuizTeacher")
  quizAttempts     QuizAttempt[]
  auditLogs        AuditLog[]
}

model Subject {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  description String?
  createdById String
  createdBy   User       @relation("SubjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  questions   Question[]
  quizzes     Quiz[]

  @@index([createdById])
}

model Question {
  id          String           @id @default(cuid())
  subjectId   String
  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  text        String
  type        QuestionType
  points      Int              @default(1)
  createdById String
  createdBy   User             @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime         @default(now())

  options     QuestionOption[]
  quizLinks   QuizQuestion[]
  answers     Answer[]

  @@index([subjectId])
  @@index([createdById])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  selectedInAnswers Answer[]

  @@index([questionId])
}

model Quiz {
  id              String         @id @default(cuid())
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  durationMinutes Int
  teacherId       String
  teacher         User           @relation("QuizTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  startsAt        DateTime
  endsAt          DateTime
  isPublished     Boolean        @default(false)
  createdAt       DateTime       @default(now())

  questions       QuizQuestion[]
  attempts        QuizAttempt[]

  @@index([subjectId])
  @@index([teacherId])
}

model QuizQuestion {
  id         String   @id @default(cuid())
  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  order      Int

  @@unique([quizId, questionId])
}

model QuizAttempt {
  id                     String    @id @default(cuid())
  quizId                 String
  quiz                   Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId              String
  student                User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt              DateTime  @default(now())
  submittedAt            DateTime?
  score                  Float?
  defocusCount           Int       @default(0)
  defocusDurationSeconds Int       @default(0)
  timeSpentSeconds       Int?
  answersCount           Int       @default(0)
  activeSessionToken     String?

  answers     Answer[]

  @@index([quizId])
  @@index([studentId])
  @@index([submittedAt])
}

model Answer {
  id               String          @id @default(cuid())
  attemptId        String
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  textAnswer       String?
  isCorrect        Boolean?
  pointsAwarded    Float           @default(0)

  @@index([attemptId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action     String
  entityType String   @default("GENERAL")
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([resetAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}
